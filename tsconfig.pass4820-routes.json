{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve"
  },
  "include": [
    "artifacts/pass4820/typecheck-shims.d.ts",
    "artifacts/pass4820/typecheck-external-shims.d.ts",
    "artifacts/pass4820/component-typecheck-shims.d.ts",
    "app/api/security/audit-report-assembler/route.ts",
    "app/api/security/audit-watch/customer-safe-report/route.ts",
    "app/api/security/audit-watch/report/route.ts",
    "components/security/CustomerSafeAuditReportPage.tsx"
  ]
}