{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },
    "types": [],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "artifacts/pass4820/typecheck-shims.d.ts",
    "artifacts/pass4820/typecheck-external-shims.d.ts",
    "lib/security/audit-report-customer-projection.ts",
    "lib/security/audit-customer-report-pipeline.ts",
    "lib/security/audit-customer-safe-report-migration.ts",
    "lib/security/customer-safe-audit-layout.ts",
    "lib/security/customer-safe-report-route.ts",
    "lib/security/report-route-inventory.ts",
    "lib/account/audit-account-messages.ts"
  ]
}
