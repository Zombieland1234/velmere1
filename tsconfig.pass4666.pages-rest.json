{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "i18n.ts",
    "navigation.ts",
    "proxy.ts",
    "routing.ts",
    "tailwind.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "app/api/**",
    "app/[locale]/market-integrity/**",
    "app/[locale]/real-markets/**",
    "app/[locale]/shield-map/**",
    "app/[locale]/shield-pro/**",
    "app/[locale]/security/**",
    "app/[locale]/search/**",
    "app/[locale]/runtime-proof/**"
  ]
}
