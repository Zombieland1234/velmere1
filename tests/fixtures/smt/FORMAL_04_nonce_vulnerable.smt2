(set-logic QF_LIA)
(set-option :print-success false)
(declare-const nonce_0 Int)
(declare-const nonce_1 Int)
(declare-const signedNonce Int)
(declare-const replayNonce Int)
(declare-const secondAuthorization Bool)
(assert (>= nonce_0 0))
(assert (= nonce_1 nonce_0))
(assert (= replayNonce nonce_0))
(assert secondAuthorization)
(assert (= signedNonce nonce_0))
(assert (= signedNonce nonce_1))
(assert (= signedNonce replayNonce))
(check-sat)
