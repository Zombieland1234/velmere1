(set-logic QF_LIA)
(set-option :print-success false)
(declare-const totalAssets_0 Int)
(declare-const totalSupply_0 Int)
(declare-const totalAssets_1 Int)
(declare-const totalSupply_1 Int)
(declare-const deposit Int)
(declare-const withdraw Int)
(declare-const mint Int)
(declare-const burn Int)
(assert (>= totalAssets_0 totalSupply_0))
(assert (>= deposit 0))
(assert (>= withdraw 0))
(assert (<= withdraw totalAssets_0))
(assert (>= mint 0))
(assert (>= burn 0))
(assert (= totalAssets_1 (- (+ totalAssets_0 deposit) withdraw)))
(assert (= totalSupply_1 (- (+ totalSupply_0 mint) burn)))
(assert (>= burn (- (+ mint withdraw) deposit)))
(assert (< totalAssets_1 totalSupply_1))
(check-sat)
