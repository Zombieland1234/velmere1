(set-logic QF_LIA)
(set-option :print-success false)
(declare-const initialAssets Int)
(declare-const deposits Int)
(declare-const withdrawals Int)
(declare-const assets_1 Int)
(assert (>= initialAssets 0))
(assert (>= deposits 0))
(assert (>= withdrawals 0))
(assert (= assets_1 (- (+ initialAssets deposits) withdrawals)))
(assert (> withdrawals (+ initialAssets deposits)))
(check-sat)
