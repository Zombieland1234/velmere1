#!/usr/bin/env python3
from __future__ import annotations

import datetime as dt
import hashlib
import json
import os
import pathlib
import shutil
import subprocess
import sys
import time
from typing import Any

ROOT = pathlib.Path(__file__).resolve().parent
CORPUS = json.loads((ROOT / "contracts.json").read_text(encoding="utf-8"))
OUT = ROOT / "evidence"
CASES_ROOT = OUT / "cases"
RAW = OUT / "raw"
RECEIPTS = OUT / "receipts"
TOOLS = ("solc", "slither", "semgrep", "forge")
EXPECTED_VERSIONS = {
    "solc": "0.8.24",
    "slither": "0.11.5",
    "semgrep": "1.130.0",
    "forge": "1.2.3",
}


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: pathlib.Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def safe_env(extra: dict[str, str] | None = None) -> dict[str, str]:
    keep = ("PATH", "HOME", "LANG", "LC_ALL", "TMPDIR", "PYTHONPATH", "VIRTUAL_ENV")
    env = {k: os.environ[k] for k in keep if k in os.environ}
    env.update({
        "CI": "true",
        "NO_COLOR": "1",
        "SEMGREP_SEND_METRICS": "off",
        "SEMGREP_ENABLE_VERSION_CHECK": "0",
        "PYTHONHASHSEED": "0",
    })
    if extra:
        env.update(extra)
    return env


def run(cmd: list[str], cwd: pathlib.Path, timeout: int = 180, env_extra: dict[str, str] | None = None) -> dict[str, Any]:
    started = dt.datetime.now(dt.timezone.utc)
    t0 = time.monotonic()
    try:
        cp = subprocess.run(
            cmd,
            cwd=cwd,
            env=safe_env(env_extra),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
        return {
            "startedAt": started.isoformat(),
            "durationMs": round((time.monotonic() - t0) * 1000, 3),
            "exitCode": cp.returncode,
            "timedOut": False,
            "stdout": cp.stdout,
            "stderr": cp.stderr,
        }
    except subprocess.TimeoutExpired as e:
        return {
            "startedAt": started.isoformat(),
            "durationMs": round((time.monotonic() - t0) * 1000, 3),
            "exitCode": None,
            "timedOut": True,
            "stdout": e.stdout or b"",
            "stderr": e.stderr or b"",
        }


def tool_metadata(name: str, version_cmd: list[str]) -> dict[str, Any]:
    exe = shutil.which(version_cmd[0])
    if not exe:
        raise SystemExit(f"missing tool: {name}")
    exe_path = pathlib.Path(exe)
    real = exe_path.resolve()
    vr = run(version_cmd, ROOT, timeout=60)
    metadata = {
        "name": name,
        "requestedVersion": EXPECTED_VERSIONS[name],
        "commandPath": str(exe_path),
        "realPath": str(real),
        "executableSha256": sha256_file(real),
        "versionExitCode": vr["exitCode"],
        "versionStdoutSha256": sha256_bytes(vr["stdout"]),
        "versionStderrSha256": sha256_bytes(vr["stderr"]),
        "versionStdout": vr["stdout"].decode("utf-8", "replace")[:4096],
        "versionStderr": vr["stderr"].decode("utf-8", "replace")[:4096],
    }
    if name in ("slither", "semgrep"):
        interpreter = pathlib.Path(sys.executable).resolve()
        metadata["interpreterPath"] = str(interpreter)
        metadata["interpreterSha256"] = sha256_file(interpreter)
    return metadata


def prepare_cases() -> list[dict[str, Any]]:
    CASES_ROOT.mkdir(parents=True, exist_ok=True)
    rows = []
    for case in CORPUS["cases"]:
        case_dir = CASES_ROOT / case["case_id"]
        src_dir = case_dir / "src"
        src_dir.mkdir(parents=True, exist_ok=True)
        source_path = src_dir / "Case.sol"
        source_path.write_text(case["source"], encoding="utf-8", newline="\n")
        actual = sha256_file(source_path)
        if actual != case["sha256"]:
            raise SystemExit(f"source hash mismatch: {case['filename']}")
        rows.append({**case, "case_dir": str(case_dir), "source_path": str(source_path)})
    return rows


def write_raw(tool: str, case_id: str, result: dict[str, Any]) -> tuple[pathlib.Path, pathlib.Path]:
    d = RAW / tool
    d.mkdir(parents=True, exist_ok=True)
    stdout_path = d / f"{case_id}.stdout.bin"
    stderr_path = d / f"{case_id}.stderr.bin"
    stdout_path.write_bytes(result["stdout"])
    stderr_path.write_bytes(result["stderr"])
    return stdout_path, stderr_path


def execute_one(tool: str, case: dict[str, Any], tool_meta: dict[str, Any], solc_path: str) -> dict[str, Any]:
    case_id = case["case_id"]
    case_dir = pathlib.Path(case["case_dir"])
    source_path = pathlib.Path(case["source_path"])
    output_files: list[pathlib.Path] = []
    if tool == "solc":
        out_dir = case_dir / "solc-out"
        out_dir.mkdir(exist_ok=True)
        cmd = ["solc", "--optimize", "--bin", "--abi", "--overwrite", "-o", str(out_dir), str(source_path)]
    elif tool == "slither":
        out_json = case_dir / "slither.json"
        cmd = ["slither", str(source_path), "--solc", solc_path, "--json", str(out_json), "--disable-color"]
        output_files.append(out_json)
    elif tool == "semgrep":
        out_json = case_dir / "semgrep.json"
        cmd = ["semgrep", "scan", "--config", str(ROOT / "semgrep-rules.yml"), "--json", "--output", str(out_json), "--metrics", "off", str(source_path)]
        output_files.append(out_json)
    elif tool == "forge":
        foundry_toml = case_dir / "foundry.toml"
        foundry_toml.write_text(
            "[profile.default]\n"
            "src = 'src'\n"
            "out = 'forge-out'\n"
            "cache_path = 'forge-cache'\n"
            f"solc = '{solc_path}'\n"
            "optimizer = true\n"
            "optimizer_runs = 200\n"
            "offline = true\n",
            encoding="utf-8",
        )
        cmd = ["forge", "build", "--root", str(case_dir), "--force"]
        output_files.append(case_dir