{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "lib/security/canonical-json.ts",
    "lib/security/cryptographic-digest.ts",
    "lib/security/portable-hmac-sha256.ts",
    "lib/worldclass/commercial-cohort-policy.ts",
    "lib/worldclass/commercial-cohort-anti-cherry-pick.ts",
    "lib/worldclass/commercial-cohort-public-checkpoint.ts",
    "lib/server/commercial-cohort-runtime.ts",
    "scripts/pass4811/commercial-cohort-fixture.ts",
    "scripts/pass4811/test-public-checkpoint-key-rotation.ts",
    "artifacts/pass4811/typecheck-shims.d.ts",
    "scripts/pass4811/verify-commercial-cohort-public-checkpoint.ts",
    "scripts/pass4811/build-commercial-cohort-trust-bundle.ts",
    "scripts/pass4811/build-commercial-cohort-public-checkpoint.ts",
    "scripts/pass4811/test-public-checkpoint-tooling.ts"
  ]
}
