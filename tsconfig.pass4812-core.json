{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "lib/security/canonical-json.ts",
    "lib/security/cryptographic-digest.ts",
    "lib/security/portable-hmac-sha256.ts",
    "lib/worldclass/commercial-cohort-policy.ts",
    "lib/worldclass/commercial-cohort-anti-cherry-pick.ts",
    "lib/worldclass/commercial-cohort-public-checkpoint.ts",
    "lib/worldclass/commercial-cohort-external-key-custody.ts",
    "lib/worldclass/commercial-cohort-transparency-publication.ts",
    "lib/worldclass/commercial-cohort-deployment-receipt.ts",
    "lib/server/commercial-cohort-runtime.ts",
    "artifacts/pass4811/typecheck-shims.d.ts",
    "artifacts/pass4812/typecheck-shims.d.ts",
    "lib/worldclass/commercial-cohort-transparency-publisher-client.ts",
    "scripts/pass4812/build-commercial-cohort-trust-bundle-external.ts",
    "scripts/pass4812/build-commercial-cohort-public-checkpoint-external.ts",
    "scripts/pass4812/build-commercial-cohort-deployment-receipt-external.ts",
    "scripts/pass4812/verify-commercial-cohort-transparency-publications.ts",
    "scripts/pass4812/verify-commercial-cohort-deployment-receipts.ts",
    "scripts/pass4811/build-commercial-cohort-public-checkpoint.ts",
    "scripts/pass4811/build-commercial-cohort-trust-bundle.ts",
    "scripts/pass4812/test-external-custody-deployment-transparency.ts",
