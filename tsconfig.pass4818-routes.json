{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "artifacts/pass4818/typecheck-shims.d.ts",
    "artifacts/pass4818/typecheck-external-shims.d.ts",
    "app/api/market-integrity/report/route.ts",
    "app/api/market-integrity/report-pdf/route.ts",
    "lib/market-integrity/real-markets-route-orchestrator.ts",
    "app/api/market-integrity/real-markets/route.ts"
  ]
}
