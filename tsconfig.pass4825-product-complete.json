{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "evaluation/**/*.ts",
    "evaluation/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "store/**/*.ts",
    "store/**/*.tsx",
    "i18n.ts",
    "navigation.ts",
    "proxy.ts",
    "routing.ts",
    "tailwind.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "archive",
    "artifacts"
  ]
}
