{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "lib/security/cryptographic-digest.ts",
    "lib/security/audit-source-candidates.ts",
    "lib/network/safe-egress.ts",
    "lib/security/audit-public-source-receipts.ts",
    "lib/security/audit-provider-runtime-client.ts",
    "lib/security/audit-runtime-confidence.ts",
    "lib/security/audit-evidence-receipt-packet.ts",
    "lib/security/pro-audit-pdf/render-pro-audit-pdf.ts",
    "lib/security/audit-report-snapshot-store.ts"
  ]
}
