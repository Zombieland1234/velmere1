{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "lib/security/cryptographic-digest.ts",
    "lib/security/pro-audit-pdf/customer-safe-renderer.ts",
    "lib/security/pro-audit-pdf/render-pro-audit-pdf.ts",
    "lib/security/audit-canonical-preview.ts",
    "lib/security/audit-report-snapshot-store.ts",
    "app/api/security/audit-watch/pro-pdf/token/route.ts",
    "app/api/security/audit-watch/pro-pdf/route.ts",
    "artifacts/pass4807/typecheck-external-shims.d.ts",
    "lib/security/client-audit-pdf-integrity.ts",
    "lib/account/audit-account-messages.ts",
    "lib/security/audit-watch-account-delivery-helpers.ts",
    "lib/commerce/vlm-paid-access-client.ts",
    "app/api/account/audit-messages/route.ts"
  ]
}
