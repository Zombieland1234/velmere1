{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "archive",
    "artifacts"
  ]
}
