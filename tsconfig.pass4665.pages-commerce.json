{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "i18n.ts",
    "navigation.ts",
    "proxy.ts",
    "routing.ts",
    "tailwind.config.ts",
    "app/[locale]/**/*.ts",
    "app/[locale]/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "app/[locale]/market-integrity/**",
    "app/[locale]/real-markets/**",
    "app/[locale]/security/**",
    "app/[locale]/shield-map/**",
    "app/[locale]/shield-pro/**",
    "app/[locale]/search/**",
    "app/[locale]/runtime-proof/**",
    "app/[locale]/risk-methodology/**"
  ]
}
