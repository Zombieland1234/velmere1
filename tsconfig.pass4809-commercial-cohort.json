{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "lib/security/canonical-json.ts",
    "lib/security/cryptographic-digest.ts",
    "lib/worldclass/commercial-cohort-policy.ts",
    "lib/server/commercial-cohort-runtime.ts",
    "scripts/pass4809/build-commercial-cohort-attestation.ts",
    "artifacts/pass4809/typecheck-shims.d.ts"
  ]
